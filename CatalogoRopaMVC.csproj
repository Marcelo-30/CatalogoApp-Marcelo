<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <FrontendRoot>frontend\</FrontendRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.6" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.6">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
    <EmbeddedResource Remove="tests/**/*" />
    <None Remove="tests/**/*" />
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="ComputeFilesToPublish"
          Condition="'$(SkipFrontendBuild)' != 'true' and Exists('$(FrontendRoot)package.json')">
    <Message Importance="high" Text="Building React frontend for production..." />
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm ci" />
    <Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
    <ItemGroup>
      <FrontendDistFiles Include="$(FrontendRoot)dist\**\*" />
      <ResolvedFileToPublish Include="@(FrontendDistFiles)"
                             RelativePath="wwwroot\%(RecursiveDir)%(Filename)%(Extension)"
                             CopyToPublishDirectory="PreserveNewest"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
